generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vague {
  id_vague   Int         @id @default(autoincrement())
  nom_vague  String
  is_actif   Boolean     @default(true)

  etudiants  Etudiant[]
}

model Filiere {
  id_filiere Int          @id @default(autoincrement())
  nom        String

  classes    ClasseUniv[]
}

model Niveau {
  id_niveau  Int          @id @default(autoincrement())
  nom        String

  classes    ClasseUniv[]
}

model ClasseUniv {
  id_classe   Int          @id @default(autoincrement())

  mode        ModeClasse

  filiere_id  Int
  niveau_id   Int

  delegue_id  Int?         @unique

  filiere     Filiere      @relation(fields: [filiere_id], references: [id_filiere])

  niveau      Niveau       @relation(fields: [niveau_id], references: [id_niveau])

  delegue     User?        @relation("DelegueClasse", fields: [delegue_id], references: [id_user])

  tables      Table[]
  etudiants   Etudiant[]
}

model Table {
  id_table    Int          @id @default(autoincrement())

  num_table   String
  capacite    Int          @default(8)

  classe_id   Int

  classe      ClasseUniv   @relation(fields: [classe_id], references: [id_classe])

  etudiants   Etudiant[]
}

model Etudiant {
  matricule   String       @id

  nom         String
  prenom      String

  photo       String?

  classe_id   Int
  table_id    Int
  vague_id    Int

  classe      ClasseUniv   @relation(fields: [classe_id], references: [id_classe])

  table       Table        @relation(fields: [table_id], references: [id_table])

  vague       Vague        @relation(fields: [vague_id], references: [id_vague])

  qrcode      QRCode?

  paiement    Paiement?
}

model User {
  id_user         Int           @id @default(autoincrement())

  pseudo          String        @unique

  password        String

  role            Role

  classeDelegue   ClasseUniv?   @relation("DelegueClasse")

  scans           Scan[]

  paiements       Paiement[]
}

model QRCode {
  id_qrcode       Int               @id @default(autoincrement())

  token           String            @unique

  statut          Status_QRCode     @default(INACTIF)

  date_creation   DateTime          @default(now())

  etudiant_id     String?           @unique

  etudiant        Etudiant?         @relation(fields: [etudiant_id], references: [matricule])

  scans           Scan[]

  paiement        Paiement?
}

model Paiement {
  id_paiement      Int                @id @default(autoincrement())

  montant          Float

  date_paiement    DateTime           @default(now())

  statut_paiement  StatutPaiement     @default(PAYE)

  etudiant_id      String             @unique

  qrcode_id        Int                @unique

  delegue_id       Int

  etudiant         Etudiant           @relation(fields: [etudiant_id], references: [matricule])

  qrcode           QRCode             @relation(fields: [qrcode_id], references: [id_qrcode])

  delegue          User               @relation(fields: [delegue_id], references: [id_user])
}

model Scan {
  id_scan          Int                @id @default(autoincrement())

  date_scan        DateTime           @default(now())

  resultat         ResultatScan

  message          String?

  qrcode_id        Int

  agent_id         Int

  qrcode           QRCode             @relation(fields: [qrcode_id], references: [id_qrcode])

  agent            User               @relation(fields: [agent_id], references: [id_user])
}

enum Role {
  ADMIN
  PRESIDENT
  DELEGUE
  AGENT
}

enum ModeClasse {
  PRESENTIEL
  HYBRIDE
}

enum StatutPaiement {
  NON_PAYE
  PAYE
}

enum ResultatScan {
  VALIDE
  REFUSE
  DEJA_UTILISE
}

enum Status_QRCode {
  INACTIF
  VALIDE
  USED
  EXPIRE
}